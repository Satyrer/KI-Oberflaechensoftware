# Copy this file to config/local.properties and fill in local machine values.
# config/local.properties is ignored by Git and must not be committed.

# Complete endpoint wins over host/port/path when set.
ki.endpoint=
ki.provider=ollama

# Alternative endpoint parts, used when ki.endpoint is empty.
ki.host=192.168.178.41
ki.port=11435
ki.path=/api/chat

# Optional credentials and model selection for the local AI service.
ki.apiKey=
ki.model=mistral-rag:latest
# Chat minimum: 2760 s; a larger configured timeout remains effective.
ki.timeoutSeconds=2760

# Current local AI stack / n8n.
n8n.host=192.168.178.41

# n8n WebUI import for chats from /home/chat.
# These credentials are used only locally to read/import/delete one selected WebUI chat.
n8n.web.port=5678
n8n.web.baseUrl=
n8n.web.email=
n8n.web.password=
n8n.web.timeoutSeconds=90

# Schreib-AI Workflow. Defaults to n8n.web.baseUrl / n8n.host:5678 when empty.
n8n.schreibAi.baseUrl=
n8n.schreibAi.timeoutSeconds=240

# AI answers through n8n Chat Trigger instead of direct Ollama/Mistral.
# Enable "Make Chat Publicly Available" in the n8n Chat Trigger and paste the Chat URL here.
n8n.chatWebhook.url=
n8n.chatWebhook.authorization=

# Media tools.
# ffmpeg must be available either in PATH or as an absolute path, for example:
# media.ffmpeg.path=C:\\Tools\\ffmpeg\\bin\\ffmpeg.exe
media.ffmpeg.path=ffmpeg

# Transcription can run through a n8n webhook in the VM or through a local command.
# If transcription.n8n.webhookUrl is empty, the app uses:
# n8n.web.baseUrl + /webhook/schreib-ai/transcribe
# If transcription.n8n.webhookUrl is set, the app sends multipart/form-data there with:
# - file: binary audio file
# - language: de/en/...
# - asrModel: small (default) or large-v3, chosen in the transcription tab.
# Both Whisper models use the complete server-workflow allowance:
# plain: at least 12 h + 5 min; structured: at least 12 h + 40 min.
# A longer n8n.schreibAi.timeoutSeconds remains effective; local private settings are not overwritten.
transcription.n8n.webhookUrl=
transcription.n8n.authorization=
transcription.defaultLanguage=de

# Optional local command template. Placeholders:
# {input} {output} {outputDir} {language} {model}
# The {model} placeholder is required for a custom command. Its launcher must map
# small and large-v3 to the corresponding local model and use CPU execution.
# Example for the Python Whisper CLI:
# transcription.command=whisper "{input}" --model {model} --device cpu --fp16 False --output_format txt --output_dir "{outputDir}"
transcription.command=

# Local storage folders. These folders are ignored by Git.
chat.directory=chats
